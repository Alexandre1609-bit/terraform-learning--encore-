# Copier ce fichier : cp envs/dev.tfvars.example envs/dev.tfvars
# Adapter les valeurs à votre environnement

aws_region        = "eu-west-3"
project_name      = "formation-terraform"
instance_type     = "t3.micro"
vpc_cidr          = "172.10.0.0/24"
number_of_instance = 3

ingress_rules = {

  rule1 = {
    from_port   = 0
    to_port     = 00
    protocol    = "..."
    cidr_blocks = ["0.0.0.0/0"]
    description = "..."
  }

  rule2 = {
    from_port   = 0
    to_port     = 00
    protocol    = "..."
    cidr_blocks = ["0.0.0.0/0"]
    description = "..."
  }
}

egress_rules = {

  rule1 = {
    from_port   = 0
    to_port     = 00
    protocol    = "..."
    cidr_blocks = ["0.0.0.0/0"]
    description = "..."
  }

  rule2 = {
    from_port   = 0
    to_port     = 00
    protocol    = "..."
    cidr_blocks = ["0.0.0.0/0"]
    description = "..."
  }
}